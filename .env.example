ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-4-8
ANTHROPIC_AGENT_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
ALERT_SCHEDULER_TOKEN=
APP_URL=
SEC_USER_AGENT=The Underlying Analyzer Reboot contact:jawauntb@users.noreply.github.com
SEC_REQUEST_INTERVAL_SECONDS=0.35
SEC_SOURCE_PACK_CACHE_SECONDS=21600
SEC_RESPONSE_CACHE_SECONDS=86400
SEC_MAX_RETRIES=2
EXA_API_KEY=
# Loaded from Doppler in deployed environments; do not copy secrets into .env files.
MASSIVE_API_KEY=
MASSIVE_REST_BASE_URL=https://api.massive.com
MASSIVE_TIMEOUT_SECONDS=15
MASSIVE_MAX_RETRIES=2
MASSIVE_MAX_PAGES=20
MASSIVE_STREAM_ENABLED=true
MASSIVE_WS_BASE_URL=wss://socket.massive.com
MASSIVE_STREAM_TIMEOUT_SECONDS=20
MASSIVE_STREAM_MAX_RECONNECTS=1
MASSIVE_STOCKS_PLAN=
MASSIVE_OPTIONS_PLAN=
MASSIVE_FINANCIALS_PLAN=
MARKET_DATA_FALLBACK_ENABLED=1
# Optional tabular model (TabICL v2). Leave both empty to switch the peer forecast off:
# every consumer fails open (503 / omitted section). URL is the `modal deploy
# modal_tabular.py` endpoint; the token is only needed when that deployment has one.
TABULAR_INFERENCE_URL=
TABULAR_INFERENCE_TOKEN=
# Constellation MCP (POST /mcp, POST /mcp/lattice, GET /.well-known/mcp.json). All optional.
# LATTICE_MCP_URL is the hub's MCP that ask_lattice_animals and /mcp/lattice reach; it defaults to
# https://latticeanimal-production.up.railway.app/mcp and must be https. MCP_PUBLIC_ORIGIN is the
# origin the manifest advertises. MCP_ALLOW_LOCAL=1 lets LATTICE_MCP_URL be http on loopback (a
# laptop or a test). Leave them commented out to take the defaults.
# LATTICE_MCP_URL=
# MCP_PUBLIC_ORIGIN=
# MCP_ALLOW_LOCAL=
