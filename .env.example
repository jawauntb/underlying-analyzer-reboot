ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-4-8
ANTHROPIC_AGENT_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
ALERT_SCHEDULER_TOKEN=
APP_URL=
SEC_USER_AGENT=The Underlying Analyzer Reboot contact:jawauntb@users.noreply.github.com
SEC_REQUEST_INTERVAL_SECONDS=0.35
SEC_SOURCE_PACK_CACHE_SECONDS=21600
SEC_RESPONSE_CACHE_SECONDS=86400
SEC_MAX_RETRIES=2
EXA_API_KEY=
# Loaded from Doppler in deployed environments; do not copy secrets into .env files.
MASSIVE_API_KEY=
MASSIVE_REST_BASE_URL=https://api.massive.com
MASSIVE_TIMEOUT_SECONDS=15
MASSIVE_MAX_RETRIES=2
MASSIVE_MAX_PAGES=20
MASSIVE_STREAM_ENABLED=true
MASSIVE_WS_BASE_URL=wss://socket.massive.com
MASSIVE_STREAM_TIMEOUT_SECONDS=20
MASSIVE_STREAM_MAX_RECONNECTS=1
MASSIVE_STOCKS_PLAN=
MASSIVE_OPTIONS_PLAN=
MASSIVE_FINANCIALS_PLAN=
MARKET_DATA_FALLBACK_ENABLED=1
# Optional tabular model (TabICL v2). Leave both empty to switch the peer forecast off:
# every consumer fails open (503 / omitted section). URL is the `modal deploy
# modal_tabular.py` endpoint; the token is only needed when that deployment has one.
TABULAR_INFERENCE_URL=
TABULAR_INFERENCE_TOKEN=
# Constellation MCP (POST /mcp, POST /mcp/lattice, GET /.well-known/mcp.json). All optional.
# LATTICE_MCP_URL is the hub's MCP that ask_lattice_animals and /mcp/lattice reach; it defaults to
# https://latticeanimal-production.up.railway.app/mcp and must be https. MCP_PUBLIC_ORIGIN is the
# origin the manifest advertises. MCP_ALLOW_LOCAL=1 lets LATTICE_MCP_URL be http on loopback (a
# laptop or a test). MCP_PEER_FORECAST_DAILY_CAP is how many uncached peer_forecast computations
# (they spend model credits) /mcp allows per process per UTC day; the default is 20, 0 allows
# none, a cached forecast is free, and the REST route is not capped. gunicorn runs three workers,
# each with its own count, so the effective cap is up to three times the number. Leave them
# commented out to take the defaults.
# LATTICE_MCP_URL=
# MCP_PUBLIC_ORIGIN=
# MCP_ALLOW_LOCAL=
# MCP_PEER_FORECAST_DAILY_CAP=
# vol-watch worker (python -m app.vol_watch). Push channels: any subset.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
VOL_WATCH_WEBHOOK_URL=
VOL_WATCH_TICKERS=XSP,MU,TSLA,LLY,AVGO,QQQ,VIX,SVXY,VIXM,EWZ,SOYB,CANE,SOXX,DRAM,XBI,MRNA,COPX,COLO,SDGR
VOL_WATCH_STATE_PATH=
VOL_WATCH_TICK_MINUTES=5
VOL_WATCH_CHAIN_MINUTES=15
VOL_WATCH_IV_RANK_HIGH=50
VOL_WATCH_IV_RANK_LOW=20
VOL_WATCH_SPREAD_RICH=8
VOL_WATCH_SPREAD_CHEAP=-3
VOL_WATCH_SKEW_SPIKE=12
VOL_WATCH_RANK_SAMPLES=252
VOL_WATCH_MAX_REL_SPREAD=0.25
VOL_WATCH_MIN_IV=5
VOL_WATCH_VIX_GATE_POINTS=2
VOL_WATCH_ALERT_COOLDOWN_MINUTES=30
VOL_WATCH_DROP_PCT=0.75
VOL_WATCH_VIX_JUMP_PCT=8
VOL_WATCH_DROP_WINDOW_MINUTES=60
VOL_WATCH_DROP_COOLDOWN_MINUTES=60
# trade watcher (runs inside the vol-watch service when a Robinhood token is set).
# Read-only by construction: the client only GETs orders/positions/marks. Set username and
# password in the Railway dashboard; the server logs in and you approve the prompt in the
# Robinhood app. The session is cached on the volume. A token works too if you have one.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_SESSION_DIR=
ROBINHOOD_TOKEN=
ROBINHOOD_REFRESH_TOKEN=
ROBINHOOD_DEVICE_TOKEN=
TRADE_WATCH_POLL_SECONDS=30
TRADE_WATCH_DAY_BUDGET=500
TRADE_WATCH_STATE_PATH=
TRADE_WATCH_LEDGER_CSV=
# Optional Google Sheet ledger (off unless set): service-account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TITLE=trade-ledger-fills
GOOGLE_SHEET_SHARE_EMAIL=
# futures watcher (always on; no credentials needed)
FUTURES_SNAPSHOT_TIMES=06:30,08:30,12:30,16:30
FUTURES_TICK_MINUTES=5
FUTURES_MOVE_ES=0.75
FUTURES_MOVE_NQ=0.75
FUTURES_MOVE_GC=1.0
FUTURES_MOVE_CL=2.0
FUTURES_MOVE_VX=8.0
FUTURES_MOVE_GLD=1.0
FUTURES_OVERNIGHT_PCT=1.0
FUTURES_COOLDOWN_MINUTES=60
FUTURES_WATCH_STATE_PATH=
FUTURES_ES_LEVELS=7700,7720,7740,7800,7840,7880
FUTURES_LEVEL_COOLDOWN_MINUTES=30
# trade cards: cap on max loss for any spread a card suggests
CARD_MAX_LOSS=300
CARD_SPOT_SIZE=100
